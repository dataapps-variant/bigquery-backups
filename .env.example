# --- Google Cloud / BigQuery ---
# GCP project whose BigQuery assets should be backed up (required)
GCP_PROJECT_ID=my-gcp-project

# Path to a service account JSON key file. Leave unset to use Application
# Default Credentials (e.g. `gcloud auth application-default login`, or the
# ambient credentials of a CI runner / GCE / Cloud Build service account).
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated list of dataset IDs to back up. Leave empty to back up
# every dataset in the project.
BQ_DATASETS=

# Comma-separated list of BigQuery locations/regions to check for scheduled
# queries (transfer configs are location-scoped). Defaults to "US".
BQ_LOCATIONS=US

# Back up BigQuery Studio "saved queries" (true/false). These can be spread
# across multiple regions (a Dataform-backed system, independent of your
# dataset locations). Add a "Location" column in the BigQuery Studio
# "Queries" panel (column picker icon in the results table) to see exactly
# which regions your saved queries actually live in, then list all of them
# here, comma-separated.
SAVED_QUERIES_ENABLED=true
SAVED_QUERIES_LOCATIONS=us-central1

# --- Backup output ---
# Folder (relative to the project root, or absolute) where backup files are written
BACKUP_ROOT_DIR=backups

# Each run creates a new dated snapshot folder (backups/YYYY-MM-DD/) rather
# than overwriting one folder in place, so comparing two snapshots shows
# exactly what was added/removed/changed between runs. Only the most recent
# N snapshots are kept — older ones are deleted automatically.
SNAPSHOT_RETENTION_COUNT=3

# --- Git / GitHub ---
# Set to false to skip committing/pushing entirely (local backup only)
GIT_PUSH_ENABLED=true

# Remote URL to push to, e.g. https://github.com/<user>/<repo>.git or
# git@github.com:<user>/<repo>.git. Required if GIT_PUSH_ENABLED=true and the
# repo has no "origin" remote configured yet.
GIT_REMOTE_URL=

# Branch to commit and push to
GIT_BRANCH=main

# Personal Access Token used for HTTPS push authentication. If set, it is
# combined with GIT_REMOTE_URL (must be an https:// URL) at push time — never
# written to disk or committed. Not needed if you use an SSH remote with keys
# already configured, or a git credential helper.
GITHUB_TOKEN=

# Identity used for the automated commit
GIT_USER_NAME=BigQuery Backup Bot
GIT_USER_EMAIL=bigquery-backup-bot@users.noreply.github.com

# Prefix for the commit message (a UTC timestamp is appended)
GIT_COMMIT_MESSAGE_PREFIX=Automated BigQuery backup

# --- Misc ---
LOG_LEVEL=INFO
